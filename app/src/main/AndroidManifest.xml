<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MyApplication"
        android:allowAudioPlaybackCapture="true"
        android:allowBackup="true"
        android:label="LYRA"
        android:theme="@style/Theme.Myra"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/workspace_network_security">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity android:name=".ui.settings.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.settings.SkillManagerActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.settings.SkillImportPreviewActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.settings.SkillGitHubPreviewActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.settings.SkillDetailActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.settings.SkillReadinessActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.settings.SkillUpdatePreviewActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.settings.SkillRollbackPreviewActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.settings.SkillUninstallPreviewActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.settings.MemorySettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.settings.ScreenVisionSettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.settings.ApiCloudSettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.settings.DeepResearchSettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.settings.VoiceAiSettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.workspace.WorkspaceTaskActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.workspace.WorkspaceScopedEditActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.workspace.WorkspaceStructuredEditActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.workspace.WorkspaceChatProposalActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.workspace.WorkspacePreviewActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.workspace.WorkspaceEditorActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.workspace.WorkspaceProjectActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.workspace.WorkspaceActivity" android:exported="false" android:screenOrientation="portrait" android:theme="@style/Theme.Myra.Workspace" />
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".service.AccessibilityHelperService"
            android:exported="true"
            android:label="LYRA device actions"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <service
            android:name=".service.MyraVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name=".screen.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:stopWithTask="false" />
        <service
            android:name=".service.WhatsAppNotificationService"
            android:exported="true"
            android:label="LYRA notification intelligence"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>

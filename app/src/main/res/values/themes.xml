<resources>
    <style name="Theme.Myra" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="colorPrimary">@color/red</item>
        <item name="colorSecondary">@color/purple</item>
    </style>
    <style name="MyraLabel">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item><item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">#6F6870</item><item name="android:textSize">12sp</item><item name="android:letterSpacing">0.08</item>
    </style>
    <style name="MyraField">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">58dp</item>
        <item name="android:background">@drawable/bg_field</item><item name="android:textColor">#EEEEEE</item>
        <item name="android:textColorHint">#5C565C</item><item name="android:textSize">15sp</item><item name="android:paddingHorizontal">18dp</item>
    </style>
    <style name="MyraChoice" parent="MyraField">
        <item name="android:gravity">center_vertical</item><item name="android:drawableEnd">@android:drawable/arrow_down_float</item><item name="android:drawableTint">#AAAAAA</item>
    </style>
    <style name="MyraPill" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item><item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">8dp</item><item name="android:button">@null</item><item name="android:background">@drawable/bg_pill</item>
        <item name="android:gravity">center</item><item name="android:textColor">#AAAAAA</item><item name="android:textSize">11sp</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#EEEEEE"
                android:textSize="36sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skills"
                    android:textColor="#EEEEEE"
                    android:textSize="25sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verified installed packages and current activation state"
                    android:textColor="#777077"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_field"
            android:padding="14dp"
            android:text="Installed skills stay approval-bound. Local import preview can inspect SKILL.md and optional skill.json, but previewing does not install or enable anything."
            android:textColor="#8E888E"
            android:textSize="11sp" />

        <Button
            android:id="@+id/previewImportButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button"
            android:text="PREVIEW LOCAL SKILL"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            style="@style/MyraLabel"
            android:text="INSTALLED SKILLS" />

        <TextView
            android:id="@+id/catalogStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:text="Verifying installed skill packages…"
            android:textColor="#777077"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:gravity="center"
            android:text="No skills installed yet.\nYou can preview a local skill above; installation remains a separate approval step."
            android:textAlignment="center"
            android:textColor="#777077"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/skillsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>

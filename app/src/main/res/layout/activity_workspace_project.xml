<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#020609">
    <ImageButton android:id="@+id/backButton" android:layout_width="48dp"
        android:layout_height="48dp" android:layout_marginStart="12dp"
        android:layout_marginTop="16dp" android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back to Workspace" android:src="@drawable/ic_arrow_back"
        android:tint="#A8FFB2" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/headerTitle" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="23dp"
        android:letterSpacing="0.15" android:text="WORKSPACE / PROJECT"
        android:textColor="#91C99B" android:textSize="10sp" android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ScrollView android:layout_width="0dp" android:layout_height="0dp"
        android:layout_marginTop="23dp" android:clipToPadding="false"
        android:fillViewport="true" android:paddingBottom="28dp" android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerTitle">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp">
            <TextView android:id="@+id/projectTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2"
                android:textColor="#F1FFF3" android:textSize="27sp" android:textStyle="bold" />
            <TextView android:id="@+id/projectType" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="7dp"
                android:textColor="#A1C4A8" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="27dp" android:background="@drawable/bg_workspace_project_card"
                android:orientation="vertical" android:padding="21dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:letterSpacing="0.11" android:text="PROJECT HOME"
                    android:textColor="#98D4A1" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="Your project, your files"
                    android:textColor="#F1FFF3" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="7dp" android:lineSpacingExtra="3dp"
                    android:text="Create files, edit code and preview saved website changes in LYRA or Chrome."
                    android:textColor="#B2C9B7" android:textSize="13sp" />
                <TextView android:id="@+id/openEditorButton" android:layout_width="match_parent"
                    android:layout_height="56dp" android:layout_marginTop="21dp"
                    android:background="@drawable/bg_field" android:clickable="true"
                    android:contentDescription="Open project files and code editor" android:focusable="true"
                    android:gravity="center" android:text="☷   Open files &amp; editor   ›"
                    android:textColor="#F1FFF3" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/openPreviewButton" android:layout_width="match_parent"
                    android:layout_height="56dp" android:layout_marginTop="10dp"
                    android:background="@drawable/bg_workspace_dialog_input" android:clickable="true"
                    android:contentDescription="Preview website" android:focusable="true"
                    android:gravity="center" android:text="↗   Preview website"
                    android:textColor="#D4F8D9" android:textSize="15sp" android:textStyle="bold"
                    android:visibility="gone" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="●  Saved locally  ·  Private project"
                    android:textColor="#96C99F" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:id="@+id/projectInfoToggle" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="19dp"
                android:background="@drawable/bg_workspace_dialog_input" android:clickable="true"
                android:focusable="true" android:gravity="center_vertical"
                android:paddingStart="18dp" android:paddingEnd="18dp"
                android:text="Project information  ▾" android:textColor="#DAF2DF"
                android:textSize="14sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/projectInfoPanel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:background="@drawable/bg_workspace_project_card" android:orientation="vertical"
                android:padding="18dp" android:visibility="gone">
                <TextView android:id="@+id/projectCreatedText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:lineSpacingExtra="3dp"
                    android:textColor="#B9D2BF" android:textSize="12sp" />
                <TextView android:id="@+id/projectUpdatedText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="14dp"
                    android:lineSpacingExtra="3dp" android:textColor="#B9D2BF" android:textSize="12sp" />
                <TextView android:id="@+id/projectIdText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="14dp"
                    android:fontFamily="monospace" android:lineSpacingExtra="3dp"
                    android:textColor="#99B9A0" android:textIsSelectable="true" android:textSize="11sp" />
                <TextView android:id="@+id/projectStorageText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="14dp"
                    android:fontFamily="monospace" android:lineSpacingExtra="3dp"
                    android:textColor="#99B9A0" android:textIsSelectable="true" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:id="@+id/deleteProjectButton" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="31dp"
                android:background="?attr/selectableItemBackground" android:clickable="true"
                android:focusable="true" android:gravity="center" android:text="Delete project"
                android:textColor="#E5A0A0" android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

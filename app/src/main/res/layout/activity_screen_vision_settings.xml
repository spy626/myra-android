<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#050505" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
            <TextView android:id="@+id/backButton" android:layout_width="44dp" android:layout_height="44dp"
                android:gravity="center" android:text="‹" android:textColor="#EEEEEE" android:textSize="36sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Screen Vision" android:textColor="#EEEEEE" android:textSize="23sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/activeIndicator" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_field" android:gravity="center" android:padding="14dp"
            android:text="○ NOT SHARING" android:textColor="#A8FFB2" android:textStyle="bold" />
        <TextView android:id="@+id/stateText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingVertical="10dp" android:text="Status: IDLE" android:textColor="#9B949B" />
        <ImageView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="190dp"
            android:background="#101010" android:contentDescription="Current shared-screen preview"
            android:scaleType="centerInside" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="horizontal">
            <Button android:id="@+id/shareButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
                android:text="SHARE SCREEN" android:backgroundTint="#2D483A" android:textColor="#FFFFFF" />
            <Button android:id="@+id/stopButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
                android:text="STOP" android:enabled="false" android:backgroundTint="#4B272B" android:textColor="#FFFFFF" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/pauseButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="PAUSE" android:enabled="false" android:backgroundTint="#242124" android:textColor="#FFFFFF" />
            <Button android:id="@+id/resumeButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="RESUME" android:enabled="false" android:backgroundTint="#242124" android:textColor="#FFFFFF" />
        </LinearLayout>
        <TextView style="@style/MyraLabel" android:text="VISION &amp; PRIVACY" />
        <Switch android:id="@+id/visionSwitch" android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Screen Vision" android:textColor="#EEEEEE" />
        <Switch android:id="@+id/learningSwitch" android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Automatic Screen Learning" android:textColor="#EEEEEE" />
        <Switch android:id="@+id/saveMemorySwitch" android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Save Screen Memories" android:textColor="#EEEEEE" />
        <Switch android:id="@+id/sensitiveSwitch" android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Sensitive Content Protection" android:textColor="#EEEEEE" />
        <TextView style="@style/MyraLabel" android:text="FRAME INTERVAL" />
        <Spinner android:id="@+id/intervalSpinner" android:layout_width="match_parent" android:layout_height="52dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="Frames are temporary and are not saved to the phone. Android always shows a notification while sharing is active."
            android:textColor="#777077" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>


<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_ambient" android:paddingHorizontal="16dp">
    <LinearLayout android:id="@+id/brandBlock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="22dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MYRA" android:textColor="#FF1744" android:textSize="18sp" android:textStyle="bold" android:letterSpacing="0.32" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI COMPANION" android:textColor="#705A68" android:textSize="8sp" android:fontFamily="monospace" android:letterSpacing="0.18" />
    </LinearLayout>
    <ImageButton android:id="@+id/settingsButton" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Settings" android:src="@android:drawable/ic_menu_preferences" android:tint="#8E7788" app:layout_constraintTop_toTopOf="@id/brandBlock" app:layout_constraintEnd_toEndOf="parent" />
    <com.myra.assistant.ui.main.OrbAnimationView android:id="@+id/orb" android:layout_width="190dp" android:layout_height="190dp" app:layout_constraintTop_toBottomOf="@id/brandBlock" app:layout_constraintBottom_toTopOf="@id/statusText" app:layout_constraintVertical_bias="0.33" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap the mic to wake MYRA" android:textColor="#806B78" android:textSize="11sp" android:fontFamily="monospace" app:layout_constraintBottom_toTopOf="@id/chatScroll" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <ScrollView android:id="@+id/chatScroll" android:layout_width="0dp" android:layout_height="156dp" android:fillViewport="true" android:scrollbars="none" android:layout_marginBottom="10dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toTopOf="@id/composer">
        <LinearLayout android:id="@+id/chatContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="bottom" android:paddingVertical="6dp" />
    </ScrollView>
    <LinearLayout android:id="@+id/composer" android:layout_width="0dp" android:layout_height="48dp" android:orientation="horizontal" android:background="@drawable/bg_field" android:gravity="center_vertical" android:paddingLeft="4dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toTopOf="@id/controlRow">
        <EditText android:id="@+id/textInput" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:hint="Type a message to MYRA…" android:singleLine="true" android:textColor="#EEEEEE" android:textColorHint="#5D4A58" android:textSize="13sp" />
        <ImageButton android:id="@+id/sendButton" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Send" android:src="@android:drawable/ic_menu_send" android:tint="#FF1744" />
    </LinearLayout>
    <LinearLayout android:id="@+id/controlRow" android:layout_width="wrap_content" android:layout_height="76dp" android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="12dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageButton android:id="@+id/muteButton" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginEnd="22dp" android:background="@drawable/bg_circle_outline" android:alpha="0.6" android:contentDescription="Mute" android:src="@android:drawable/ic_lock_silent_mode" android:tint="#FF1744" />
        <ImageButton android:id="@+id/connectButton" android:layout_width="66dp" android:layout_height="66dp" android:background="@drawable/bg_circle_outline" android:contentDescription="Connect microphone" android:src="@android:drawable/ic_btn_speak_now" android:tint="#FF1744" />
        <ImageButton android:id="@+id/stopButton" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="22dp" android:background="@drawable/bg_circle_outline" android:alpha="0.6" android:contentDescription="Stop MYRA" android:src="@android:drawable/ic_media_pause" android:tint="#FF1744" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#EEEEEE"
                android:textSize="36sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GitHub skill preview"
                    android:textColor="#EEEEEE"
                    android:textSize="25sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Public read-only · immutable commit pinning"
                    android:textColor="#777077"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_field"
            android:padding="14dp"
            android:text="Paste a public repository root containing SKILL.md, or a direct GitHub SKILL.md blob/raw link. LYRA pins one commit before reading, optionally reads skill.json from the same directory, and never clones, executes or installs in this slice."
            android:textColor="#8E888E"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/githubUrl"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_field"
            android:hint="https://github.com/owner/repo"
            android:inputType="textUri"
            android:maxLines="2"
            android:paddingHorizontal="14dp"
            android:textColor="#EEEEEE"
            android:textColorHint="#777077"
            android:textSize="13sp" />

        <Button
            android:id="@+id/previewButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button"
            android:text="PIN &amp; PREVIEW"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/progressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ready"
            android:textColor="#777077"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/MyraLabel"
                android:text="PINNED PREVIEW" />

            <TextView
                android:id="@+id/previewStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHECKING"
                android:textColor="#8E888E"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/previewName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Skill"
                android:textColor="#EEEEEE"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/previewDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text=""
                android:textColor="#C9C4C9"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_field"
                android:padding="14dp"
                android:text="EXTERNAL UNTRUSTED DATA · Preview does not grant tool, network, source, memory, model, install or verification authority."
                android:textColor="#8E888E"
                android:textSize="11sp" />

            <TextView
                style="@style/MyraLabel"
                android:text="PERMISSIONS &amp; PROVENANCE" />

            <LinearLayout
                android:id="@+id/previewRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/MyraLabel"
                android:text="WARNINGS" />

            <LinearLayout
                android:id="@+id/warningRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

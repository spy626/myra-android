<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#EEEEEE"
                android:textSize="36sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Memory Core"
                    android:textColor="#EEEEEE"
                    android:textSize="25sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View and control what LYRA remembers"
                    android:textColor="#777077"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/addMemoryButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button"
            android:text="ADD MEMORY"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            style="@style/MyraLabel"
            android:text="PASSIVE LEARNING" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_field"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <Switch
                android:id="@+id/passiveAppLearningSwitch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Learn app-use patterns"
                android:textColor="#EEEEEE"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/passiveContentLearningSwitch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Learn YouTube/content patterns"
                android:textColor="#EEEEEE"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:text="Private, banking, authenticator and sensitive screens stay blocked even when learning is on."
                android:textColor="#777077"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView style="@style/MyraLabel" android:text="ACTIVE MEMORIES" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/memoryFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:gravity="center"
            android:text="No memories saved"
            android:textColor="#777077"
            android:textSize="14sp" />
        <LinearLayout
            android:id="@+id/memoryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/deleteAllButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_field"
            android:text="DELETE ALL MEMORIES"
            android:textColor="#FF506E"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020609"
    android:orientation="vertical">

    <TextView
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="‹  Back to LYRA"
        android:textColor="#C9FFD0"
        android:textSize="15sp"
        android:clickable="true"
        android:focusable="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VIDEO STUDIO"
                android:letterSpacing="0.1"
                android:textColor="#C9FFD0"
                android:textStyle="bold"
                android:textSize="23sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Slice 5 · Storyboard + reviewed Blender test request. Not automatic video generation"
                android:textColor="#9FC4A5"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Describe your video"
                android:textColor="#F1FFF3"
                android:textStyle="bold"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/promptInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_field"
                android:gravity="top|start"
                android:hint="Example: Build a modern two-floor mini house with a garden"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="1500"
                android:minHeight="116dp"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#A1BFA6"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Video type"
                android:textColor="#F1FFF3"
                android:textStyle="bold"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/kindSpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:contentDescription="Choose video category"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="YouTube Shorts length"
                android:textColor="#F1FFF3"
                android:textStyle="bold"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/durationGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/duration30"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:checked="true"
                    android:text="30 seconds"
                    android:textColor="#D8F6DD"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/duration60"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="20dp"
                    android:text="60 seconds"
                    android:textColor="#D8F6DD"
                    android:textSize="14sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/previewButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_workspace_dialog_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Preview storyboard  ›"
                android:contentDescription="Preview a text storyboard only, not a video"
                android:textColor="#D8F6DD"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reviewRenderRequestButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_workspace_dialog_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Review 6s Blender test request"
                android:contentDescription="Review and share structured mini-house render request. Does not create video."
                android:textColor="#C9FFD0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Test-request sharing only. Rendering is not started from LYRA yet. Target 30s/60s videos are not available."
                android:textColor="#9FC4A5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/storyboardText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_workspace_project_card"
                android:padding="16dp"
                android:text="Your suggested scene timings will appear here. No video is generated at this stage."
                android:textColor="#CBE7D0"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>

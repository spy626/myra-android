<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Project name"
        android:textColor="#CBE7D0"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/projectNameInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_field"
        android:hint="e.g. Minicoy Market"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLength="80"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="#F1FFF3"
        android:textColorHint="#6F8E76"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Project type"
        android:textColor="#CBE7D0"
        android:textSize="12sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/projectTypeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/projectTypeWebsite"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="#8FE49A"
            android:checked="true"
            android:text="Website  •  HTML / CSS / JavaScript"
            android:textColor="#D8F6DD"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/projectTypeAndroid"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="#8FE49A"
            android:text="Android App  •  Native Android"
            android:textColor="#D8F6DD"
            android:textSize="14sp" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="Project files stay in LYRA's private Workspace storage and remain separate from personal AIRI memory."
        android:textColor="#78957F"
        android:textSize="11sp" />

</LinearLayout>

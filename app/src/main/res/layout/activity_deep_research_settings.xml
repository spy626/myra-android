<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#050505" android:fillViewport="true" android:overScrollMode="never">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical"><TextView android:id="@+id/backButton" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="‹" android:textColor="#EEEEEE" android:textSize="36sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Deep Research Settings" android:textColor="#EEEEEE" android:textSize="23sp" android:textStyle="bold"/></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_field" android:orientation="vertical" android:padding="18dp">
        <TextView style="@style/MyraLabel" android:layout_marginTop="0dp" android:text="PROVIDER"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tavily AI (Recommended)" android:textColor="#EEEEEE" android:textSize="16sp" android:textStyle="bold"/>
        <TextView style="@style/MyraLabel" android:text="API KEY"/><EditText android:id="@+id/apiKey" style="@style/MyraField" android:hint="tvly-…" android:inputType="textPassword"/>
        <TextView style="@style/MyraLabel" android:text="CUSTOM API URL (OPTIONAL)"/><EditText android:id="@+id/apiUrl" style="@style/MyraField" android:inputType="textUri"/>
        <TextView style="@style/MyraLabel" android:text="RESEARCH DEPTH"/><TextView android:id="@+id/depthChoice" style="@style/MyraChoice"/>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Status: Not tested" android:textColor="#777077" android:textSize="13sp"/>
    </LinearLayout>
    <Button android:id="@+id/testButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:background="@drawable/bg_field" android:text="TEST CONNECTION" android:textColor="#EEEEEE"/>
    <Button android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="12dp" android:background="@drawable/bg_button" android:text="SAVE SETTINGS" android:textColor="#FFFFFF" android:textStyle="bold"/>
</LinearLayout></ScrollView>

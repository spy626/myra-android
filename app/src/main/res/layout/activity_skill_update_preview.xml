<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#EEEEEE"
                android:textSize="36sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Update preview"
                    android:textColor="#EEEEEE"
                    android:textSize="25sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/currentSkill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Installed skill"
                    android:textColor="#777077"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_field"
            android:padding="14dp"
            android:text="H10 is comparison only. It re-opens the installed immutable skill, inspects a local or pinned GitHub candidate, shows exact permission deltas, and never updates the catalog or package store."
            android:textColor="#8E888E"
            android:textSize="11sp" />

        <TextView
            style="@style/MyraLabel"
            android:text="LOCAL CANDIDATE" />

        <Button
            android:id="@+id/chooseSkillMdButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_button"
            android:text="CHOOSE SKILL.MD"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/localSkillState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="No SKILL.md selected"
            android:textColor="#777077"
            android:textSize="12sp" />

        <Button
            android:id="@+id/chooseSkillJsonButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_field"
            android:text="ADD OPTIONAL SKILL.JSON"
            android:textColor="#EEEEEE"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/localManifestState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="No skill.json selected"
            android:textColor="#777077"
            android:textSize="12sp" />

        <Button
            android:id="@+id/clearManifestButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field"
            android:text="REMOVE SKILL.JSON"
            android:textColor="#FF9EAE"
            android:visibility="gone" />

        <TextView
            style="@style/MyraLabel"
            android:text="PINNED GITHUB CANDIDATE" />

        <EditText
            android:id="@+id/githubUrl"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_field"
            android:hint="https://github.com/owner/repo or .../SKILL.md"
            android:inputType="textUri"
            android:maxLines="2"
            android:paddingHorizontal="14dp"
            android:textColor="#EEEEEE"
            android:textColorHint="#777077"
            android:textSize="13sp" />

        <Button
            android:id="@+id/githubPreviewButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button"
            android:text="PIN &amp; COMPARE"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/githubProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ready"
            android:textColor="#777077"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/MyraLabel"
                android:text="UPDATE COMPARISON" />

            <TextView
                android:id="@+id/resultSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Candidate"
                android:textColor="#777077"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/resultStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="PREVIEW"
                android:textColor="#8E888E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="#C9C4C9"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/activationImpact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_field"
                android:padding="14dp"
                android:text=""
                android:textColor="#C9C4C9"
                android:textSize="12sp" />

            <TextView
                style="@style/MyraLabel"
                android:text="IDENTITY &amp; PROVENANCE" />

            <LinearLayout
                android:id="@+id/resultRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/MyraLabel"
                android:text="PERMISSION DELTA" />

            <LinearLayout
                android:id="@+id/diffRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_field"
                android:padding="14dp"
                android:text="NO UPDATE ACTION · This screen creates no approval token/request and writes nothing. A later slice must revalidate the exact candidate and current installed state before any update can occur."
                android:textColor="#8E888E"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#050505" android:fillViewport="true" android:overScrollMode="never">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical"><TextView android:id="@+id/backButton" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="‹" android:textColor="#EEEEEE" android:textSize="36sp"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="API &amp; Cloud Settings" android:textColor="#EEEEEE" android:textSize="23sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Configure API keys and cloud services" android:textColor="#777077" android:textSize="12sp"/></LinearLayout></LinearLayout>
    <TextView style="@style/MyraLabel" android:text="OPENROUTER API KEY (OPTIONAL)"/><EditText android:id="@+id/openRouterKey" style="@style/MyraField" android:hint="sk-or-…" android:inputType="textPassword"/><Button android:id="@+id/testOpenRouter" style="@style/MyraTestButton" android:text="TEST OPENROUTER"/>
    <TextView style="@style/MyraLabel" android:text="PRIMARY LLM MODEL"/>
    <RadioGroup android:id="@+id/providerGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_field" android:padding="10dp">
        <RadioButton android:id="@+id/providerOpenRouter" style="@style/MyraProviderRadio" android:text="OpenRouter (Auto-fallback)"/>
        <RadioButton android:id="@+id/providerGroq" style="@style/MyraProviderRadio" android:text="Groq (Fastest)"/>
        <RadioButton android:id="@+id/providerGemini" style="@style/MyraProviderRadio" android:text="Gemini Live (Voice + Quality)"/>
        <RadioButton android:id="@+id/providerDeepseek" style="@style/MyraProviderRadio" android:text="DeepSeek (Good Reasoning)"/>
    </RadioGroup>
    <TextView style="@style/MyraLabel" android:text="GROQ API KEY"/><EditText android:id="@+id/groqKey" style="@style/MyraField" android:hint="gsk_…" android:inputType="textPassword"/><Button android:id="@+id/testGroq" style="@style/MyraTestButton" android:text="TEST GROQ"/>
    <TextView style="@style/MyraLabel" android:text="GEMINI API KEY"/><EditText android:id="@+id/geminiKey" style="@style/MyraField" android:inputType="textPassword"/>
    <TextView style="@style/MyraLabel" android:text="DEEPSEEK API KEY"/><EditText android:id="@+id/deepseekKey" style="@style/MyraField" android:hint="sk-…" android:inputType="textPassword"/><Button android:id="@+id/testDeepseek" style="@style/MyraTestButton" android:text="TEST DEEPSEEK"/>
    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Keys are encrypted on this phone." android:textColor="#777077" android:textSize="12sp"/>
    <TextView style="@style/MyraLabel" android:text="DEEP RESEARCH (TAVILY AI)"/><Button android:id="@+id/deepResearchButton" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_field" android:text="CONFIGURE DEEP RESEARCH SETTINGS  ›" android:textColor="#EEEEEE"/>
    <Button android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="24dp" android:background="@drawable/bg_button" android:text="SAVE CONFIGURATION" android:textColor="#FFFFFF" android:textStyle="bold"/>
</LinearLayout></ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020609">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back to project"
        android:src="@drawable/ic_arrow_back"
        android:tint="#A8FFB2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/editorHeading"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="Project files"
        android:textColor="#E7FFEC"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/backButton"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/editorContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/backButton">

        <TextView
            android:id="@+id/editorFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:paddingTop="4dp"
            android:paddingBottom="9dp"
            android:text="Select a file"
            android:textColor="#9BBFA4"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/filesButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_workspace_dialog_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="80dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="☷  Files"
                    android:textColor="#C8F3D0"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/newFileButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_workspace_dialog_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="＋ File"
                    android:textColor="#C8F3D0"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/newFolderButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_workspace_dialog_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="＋ Folder"
                    android:textColor="#C8F3D0"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/saveButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="82dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Save"
                    android:textColor="#F1FFF3"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/fileTreeScroll"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_workspace_project_card"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/fileTreeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="9dp" />
        </ScrollView>

        <TextView
            android:id="@+id/starterButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_workspace_project_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="Create website starter files"
            android:textColor="#B6F3C1"
            android:textSize="13sp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="9dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/tabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_workspace_project_card"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/lineNumbers"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="top|end"
                android:paddingStart="2dp"
                android:paddingTop="12dp"
                android:paddingEnd="7dp"
                android:lineSpacingExtra="3dp"
                android:text="1"
                android:textColor="#60826A"
                android:textSize="13sp" />
            <EditText
                android:id="@+id/codeEditor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:hint="Open or create a file to start coding"
                android:imeOptions="flagNoExtractUi"
                android:inputType="textMultiLine|textNoSuggestions"
                android:lineSpacingExtra="3dp"
                android:paddingStart="9dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp"
                android:scrollbars="vertical"
                android:textColor="#E0F3E4"
                android:textColorHint="#6E8C77"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/editorStatus"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="UTF-8  •  Workspace private"
            android:textColor="#83AA8C"
            android:textSize="11sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
